{
  "name": "@onchainrouter/openclaw",
  "version": "0.2.1",
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1"
    }
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "description": "OpenClaw provider adapter for the local Onchain Router Buyer Runtime",
  "license": "MIT",
  "author": "Onchain Router",
  "homepage": "https://onchainrouter.dev/docs/openclaw",
  "bugs": "https://github.com/OnchainRouter/onchain-router-openclaw/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OnchainRouter/onchain-router-openclaw.git"
  },
  "type": "module",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "after-install.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external openclaw",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "qualification:clean-install": "node scripts/clean-install.mjs",
    "qualification:git-install": "node scripts/git-install.mjs",
    "validate:distribution": "node scripts/validate-distribution.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm validate:distribution"
  },
  "dependencies": {
    "@onchainrouter/proxy": "0.2.0",
    "typebox": "1.3.16"
  },
  "peerDependencies": {
    "openclaw": "2026.8.1"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "openclaw": "2026.8.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "providers": [
      "onchain-router"
    ],
    "install": {
      "minHostVersion": ">=2026.8.1"
    },
    "compat": {
      "pluginApi": ">=2026.8.1",
      "minGatewayVersion": "2026.8.1"
    },
    "build": {
      "openclawVersion": "2026.8.1",
      "pluginSdkVersion": "2026.8.1"
    }
  }
}
